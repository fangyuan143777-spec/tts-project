# ---------------------------------------------------------------------------
# Secrets: never commit these.
# ---------------------------------------------------------------------------

# Environment files (keep a template like .env.example if you want one)
.env
.env.*
!.env.example
*.env

# Google Cloud service-account / credential key files
*service-account*.json
*service_account*.json
*serviceaccount*.json
*credentials*.json
*-key.json
gcp-*.json
google-*.json
application_default_credentials.json
*.pem
*.p12
*.pfx

# Local Supabase files and secrets
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/functions/.env.*
supabase/.temp/
supabase/.branches/
supabase/.secrets
supabase/.secrets.*

